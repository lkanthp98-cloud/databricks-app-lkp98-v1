# ==============================================================================
# Insurance Dashboard - Local Environment Configuration (.env)
# ==============================================================================
# Copy this file to `.env` for local testing and development.
# When deploying to Databricks Apps, values are automatically injected via `app.yaml`.
# ==============================================================================

# 1. Databricks Authentication (Required only for live connection when running locally)
# Your workspace URL (e.g., https://adb-1234567890123456.7.azuredatabricks.net or https://dbc-xyz.cloud.databricks.com)
DATABRICKS_HOST=

# Personal Access Token (PAT) from Settings -> Developer -> User Tokens
DATABRICKS_TOKEN=

# Or use a profile configured in ~/.databrickscfg:
# DATABRICKS_CONFIG_PROFILE=DEFAULT

# SQL Warehouse ID (Optional: enables direct Databricks SQL pushdown queries)
DATABRICKS_WAREHOUSE_ID=

# 2. Genie Space Configuration
# The ID from your Genie URL (the alphanumeric string after /rooms/ in the URL)
# If blank, the app runs on built-in offline demo data.
GENIE_SPACE_ID=

# 3. Unity Catalog Settings (Gold Layer)
GOLD_CATALOG=insurance_dev_gold
GOLD_SCHEMA=gold_schema

# 4. App Behavior
# Cache TTL in seconds (default 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# As-Of Date (blank = today, or set specific YYYY-MM-DD e.g. 2026-10-09)
AS_OF_DATE=
